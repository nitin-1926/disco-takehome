OPENAI_API_KEY=sk-...
# Upstash Redis (Vercel Marketplace injects one of these pairs; both spellings accepted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# In-app spend cap (USD) and epoch; change the epoch to start a fresh counter. Local dev uses "dev".
SPEND_CAP_USD=25
SPEND_CAP_EPOCH=v1
# Best-effort per-IP limiter for live (non-cached) runs
RATE_LIMIT_RUNS=20
RATE_LIMIT_WINDOW_MIN=60
# Stage-1 retrieval: candidates kept before scoring (20 = whole catalog)
RETRIEVE_K=20
