OPENAI_API_KEY=sk-...
# Upstash Redis (Vercel Marketplace injects one of these pairs; both spellings accepted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# In-app spend caps (USD): the epoch total, and per UTC day. Change the epoch to start a fresh counter.
# Use a different epoch locally (e.g. "dev") so local runs never count against the hosted counter.
SPEND_CAP_USD=25
SPEND_CAP_DAILY_USD=10
SPEND_CAP_EPOCH=dev
# Best-effort per-IP limiter for live (non-cached) runs
RATE_LIMIT_RUNS=20
RATE_LIMIT_WINDOW_MIN=60
# Stage-1 retrieval: candidates kept before scoring (20 = whole catalog)
RETRIEVE_K=20
